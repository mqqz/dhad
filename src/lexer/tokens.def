// name, canonical ASCII form for parser/AST, keyword literal (UTF-8) or nullptr
TOKEN(ENDF, "", nullptr)
TOKEN(INVALID, "", nullptr)
TOKEN(COMMENT, "", nullptr)
TOKEN(IDENTIFIER, "", nullptr)
TOKEN(LIT_NUM, "", nullptr)
TOKEN(LIT_STRING, "", nullptr)

TOKEN(KW_IMPORT, "import", u8"استورد")
TOKEN(KW_FN, "fn", u8"دالة")
TOKEN(KW_LET, "let", u8"دع")
TOKEN(KW_CONST, "const", u8"ثابت")
TOKEN(KW_IF, "if", u8"إذا")
TOKEN(KW_ELSE, "else", u8"وإلا")
TOKEN(KW_WHILE, "while", u8"طالما")
TOKEN(KW_FOR, "for", u8"لكل")
TOKEN(KW_RETURN, "return", u8"أعد")
TOKEN(KW_BREAK, "break", u8"اكسر")
TOKEN(KW_CONTINUE, "continue", u8"استمر")
TOKEN(KW_TRUE, "true", u8"صح")
TOKEN(KW_FALSE, "false", u8"خطأ")
TOKEN(KW_NULL, "null", u8"فارغ")
TOKEN(KW_INT, "int", u8"عدد")
TOKEN(KW_FLOAT, "float", u8"عشري")
TOKEN(KW_BOOL, "bool", u8"منطقي")
TOKEN(KW_CHAR, "char", u8"حرف")
TOKEN(KW_STRING, "string", u8"نص")
TOKEN(KW_NOT, "not", u8"ليس")
TOKEN(KW_OR, "or", u8"أو")
TOKEN(KW_AND, "and", u8"و")

TOKEN(PLUS, "+", nullptr)
TOKEN(MINUS, "-", nullptr)
TOKEN(MUL, "*", nullptr)
TOKEN(DIV, "/", nullptr)
TOKEN(ASSIGN, "=", nullptr)
TOKEN(EQUAL, "==", nullptr)
TOKEN(NOT_EQUAL, "!=", nullptr)
TOKEN(LESS, "<", nullptr)
TOKEN(LESS_EQUAL, "<=", nullptr)
TOKEN(GREATER, ">", nullptr)
TOKEN(GREATER_EQUAL, ">=", nullptr)

TOKEN(WHITESPACE, "", nullptr)
TOKEN(LPAREN, "(", nullptr)
TOKEN(RPAREN, ")", nullptr)
TOKEN(LBRACE, "{", nullptr)
TOKEN(RBRACE, "}", nullptr)
TOKEN(COMMA, ",", nullptr)
TOKEN(SEMICOLON, ";", nullptr)
TOKEN(COLON, ":", nullptr)
