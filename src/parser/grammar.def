RULE(AugmentedStart, NT(Program)),

RULE(Program, NT(TopLevelList), TOK(ENDF)),

RULE(TopLevelList, NT(TopLevelList), NT(TopLevel)),
RULE_EMPTY(TopLevelList),

RULE(TopLevel, NT(Import)),
RULE(TopLevel, NT(Function)),
RULE(TopLevel, NT(Statement)),

RULE(Import, TOK(KW_IMPORT), TOK(IDENTIFIER), TOK(SEMICOLON)),

RULE(Function, TOK(KW_FN), TOK(IDENTIFIER), TOK(LPAREN), NT(ParameterListOpt),
     TOK(RPAREN), NT(FunctionReturnTypeOpt), NT(Block)),
RULE(FunctionReturnTypeOpt, TOK(COLON), NT(TypeName)),
RULE_EMPTY(FunctionReturnTypeOpt),

RULE(ParameterListOpt, NT(ParameterList)),
RULE_EMPTY(ParameterListOpt),
RULE(ParameterList, NT(Parameter), NT(ParameterTail)),
RULE(ParameterTail, TOK(COMMA), NT(Parameter), NT(ParameterTail)),
RULE_EMPTY(ParameterTail),
RULE(Parameter, TOK(IDENTIFIER), TOK(COLON), NT(TypeName)),

RULE(TypeName, TOK(KW_INT)),
RULE(TypeName, TOK(KW_FLOAT)),
RULE(TypeName, TOK(KW_BOOL)),
RULE(TypeName, TOK(KW_CHAR)),
RULE(TypeName, TOK(KW_STRING)),
RULE(TypeName, TOK(KW_NULL)),

RULE(Block, TOK(LBRACE), NT(StatementList), TOK(RBRACE)),
RULE(StatementList, NT(StatementList), NT(Statement)),
RULE_EMPTY(StatementList),
RULE(Statement, NT(MatchedStatement)),
RULE(Statement, NT(UnmatchedStatement)),

RULE(MatchedStatement, NT(Declaration), TOK(SEMICOLON)),
RULE(MatchedStatement, NT(Assignment), TOK(SEMICOLON)),
RULE(MatchedStatement, NT(WhileStatement)),
RULE(MatchedStatement, NT(ForStatement)),
RULE(MatchedStatement, NT(ReturnStatement), TOK(SEMICOLON)),
RULE(MatchedStatement, NT(BreakStatement), TOK(SEMICOLON)),
RULE(MatchedStatement, NT(ContinueStatement), TOK(SEMICOLON)),
RULE(MatchedStatement, NT(CallExpression), TOK(SEMICOLON)),
RULE(MatchedStatement, NT(Block)),
RULE(MatchedStatement, NT(IfMatched)),

RULE(UnmatchedStatement, NT(IfUnmatched)),

RULE(Declaration, TOK(KW_LET), TOK(IDENTIFIER), NT(TypeAnnotationOpt),
     TOK(ASSIGN), NT(Expression)),
RULE(Declaration, TOK(KW_CONST), TOK(IDENTIFIER), NT(TypeAnnotationOpt),
     TOK(ASSIGN), NT(Expression)),
RULE(TypeAnnotationOpt, TOK(COLON), NT(TypeName)),
RULE_EMPTY(TypeAnnotationOpt),

RULE(Assignment, TOK(IDENTIFIER), TOK(ASSIGN), NT(Expression)),

RULE(IfMatched, TOK(KW_IF), TOK(LPAREN), NT(Expression), TOK(RPAREN),
     NT(MatchedStatement), TOK(KW_ELSE), NT(MatchedStatement)),

RULE(IfUnmatched, TOK(KW_IF), TOK(LPAREN), NT(Expression), TOK(RPAREN),
     NT(Statement)),
RULE(IfUnmatched, TOK(KW_IF), TOK(LPAREN), NT(Expression), TOK(RPAREN),
     NT(MatchedStatement), TOK(KW_ELSE), NT(UnmatchedStatement)),

RULE(WhileStatement, TOK(KW_WHILE), TOK(LPAREN), NT(Expression), TOK(RPAREN),
     NT(Statement)),
RULE(ForStatement, TOK(KW_FOR), TOK(LPAREN), NT(Expression), TOK(RPAREN),
     NT(Statement)),

RULE(ReturnStatement, TOK(KW_RETURN), NT(ReturnExpressionOpt)),
RULE(ReturnExpressionOpt, NT(Expression)),
RULE_EMPTY(ReturnExpressionOpt),
RULE(BreakStatement, TOK(KW_BREAK)),
RULE(ContinueStatement, TOK(KW_CONTINUE)),

RULE(CallExpression, TOK(IDENTIFIER), TOK(LPAREN), NT(ArgumentListOpt),
     TOK(RPAREN)),
RULE(ArgumentListOpt, NT(ArgumentList)),
RULE_EMPTY(ArgumentListOpt),
RULE(ArgumentList, NT(Expression), NT(ArgumentTail)),
RULE(ArgumentTail, TOK(COMMA), NT(Expression), NT(ArgumentTail)),
RULE_EMPTY(ArgumentTail),

RULE(Expression, NT(LogicalOr)),
RULE(LogicalOr, NT(LogicalOr), TOK(KW_OR), NT(LogicalAnd)),
RULE(LogicalOr, NT(LogicalAnd)),
RULE(LogicalAnd, NT(LogicalAnd), TOK(KW_AND), NT(Equality)),
RULE(LogicalAnd, NT(Equality)),
RULE(Equality, NT(Equality), TOK(EQUAL), NT(Comparison)),
RULE(Equality, NT(Equality), TOK(NOT_EQUAL), NT(Comparison)),
RULE(Equality, NT(Comparison)),
RULE(Comparison, NT(Comparison), TOK(LESS), NT(Term)),
RULE(Comparison, NT(Comparison), TOK(LESS_EQUAL), NT(Term)),
RULE(Comparison, NT(Comparison), TOK(GREATER), NT(Term)),
RULE(Comparison, NT(Comparison), TOK(GREATER_EQUAL), NT(Term)),
RULE(Comparison, NT(Term)),
RULE(Term, NT(Term), TOK(PLUS), NT(Factor)),
RULE(Term, NT(Term), TOK(MINUS), NT(Factor)),
RULE(Term, NT(Factor)),
RULE(Factor, NT(Factor), TOK(MUL), NT(Unary)),
RULE(Factor, NT(Factor), TOK(DIV), NT(Unary)),
RULE(Factor, NT(Unary)),
RULE(Unary, TOK(KW_NOT), NT(Unary)),
RULE(Unary, TOK(MINUS), NT(Unary)),
RULE(Unary, NT(Primary)),
RULE(Primary, TOK(LIT_NUM)),
RULE(Primary, TOK(LIT_STRING)),
RULE(Primary, TOK(KW_TRUE)),
RULE(Primary, TOK(KW_FALSE)),
RULE(Primary, TOK(KW_NULL)),
RULE(Primary, TOK(IDENTIFIER)),
RULE(Primary, NT(CallExpression)),
RULE(Primary, TOK(LPAREN), NT(Expression), TOK(RPAREN))
