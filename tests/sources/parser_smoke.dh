استورد أساس؛

دالة بداية(): عدد {
    دع س: عدد = 10؛
    دع مصفوفة: [عدد] = [1, 2, 3]؛
    دع احتمال: عدد | نص = 0؛
    دع زوج: عدد * عدد = 1؛
    ثابت ض = 20؛

    إذا (س < ض) {
        اطبع("س أقل")؛
    } وإلا إذا (س == ض) {
        اطبع("متساوي")؛
    } وإلا {
        اطبع("س أكبر")؛
    }

    طالما (س > 0 و ليس خطأ) {
        س = س - 1؛
        إذا (س == 5) اكسر؛
    }

    أعد صح؛
}
